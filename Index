function showPrayer(key){
    const text =
        state[`${key}Text`] ||
        'לא הוזן עדיין נוסח תפילה.';

    const overlay = $('prayerOverlay');
    const content = $('overlayContent');

    const speedSetting = Number(state.prayerSpeed) || 40;

    content.replaceChildren(
        ...text.split(/\r?\n/).map((line,index)=>{
            const span = document.createElement('span');
            span.className = 'prayer-line';
            span.style.setProperty('--line-index',index);
            span.textContent = line || ' ';
            return span;
        })
    );

    overlay.classList.add('active');
    overlay.setAttribute('aria-hidden','false');

    /* Stop old animation */
    content.style.animation = 'none';

    /*
       Prayer scrolling speed.

       Slider:
       10  = very slow
       120 = faster

       Pixels per second:
       about 8px/sec at slowest
       about 32px/sec at fastest
    */
    const pixelsPerSecond =
        6 + (speedSetting / 120) * 26;

    /*
       Total distance:
       prayer height
       + screen height
       + a little extra space
    */
    const distance =
        content.scrollHeight +
        window.innerHeight * 1.10;

    /*
       Longer prayer automatically gets
       a longer animation duration.
    */
    const duration =
        distance / pixelsPerSecond;

    content.style.setProperty(
        '--prayer-duration',
        `${duration}s`
    );

    /* Restart animation */
    void content.offsetHeight;

    content.style.animation =
        'prayerScroll var(--prayer-duration) linear infinite';
}
